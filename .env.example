# Copy to .env and replace both secrets before starting the service.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
SESSION_SIGNING_KEY=
API_URL=http://api:8080
COOKIE_SECURE=true
WEB_PORT=8080
WEB_BIND_ADDRESS=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
CURRENT_MONTH_REFRESH_SECONDS=3600
OLDER_MONTH_REFRESH_SECONDS=86400
# Extraction defaults to Pdfium. Set to marker only after starting the optional
# worker profile and setting MARKER_WORKER_URL=http://marker:8000.
PDF_EXTRACTION_ENGINE=pdfium
MARKER_WORKER_URL=
MARKER_WORKER_TIMEOUT_SECONDS=120
MARKER_WORKER_MAX_RESPONSE_BYTES=8388608
MARKER_WORKER_MAX_CONCURRENCY=1
# Worker-only settings (used when the marker profile is enabled).
MARKER_MODE=fast
MARKER_WORKER_MAX_INPUT_BYTES=26214400
MARKER_WORKER_EXECUTION_TIMEOUT_SECONDS=110
