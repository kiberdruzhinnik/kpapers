# Copy this file to .env in the same directory as compose.yaml.
IMAGE_TAG=latest
OPERATOR_USERNAME=operator
# Wrap the generated PHC hash in single quotes when filling this value.
OPERATOR_PASSWORD_HASH=
SESSION_SIGNING_KEY=
API_URL=http://api:8080
COOKIE_SECURE=true
WEB_PORT=8080
WEB_BIND_ADDRESS=0.0.0.0
PUBLIC_BASE_URL=https://kpapers.example.com
CURRENT_MONTH_REFRESH_SECONDS=3600
OLDER_MONTH_REFRESH_SECONDS=86400
