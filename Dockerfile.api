FROM rust:1-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
RUN cargo build --release

FROM debian:bookworm-slim AS pdfium
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && case "$TARGETARCH" in \
        amd64) runtime="linux-x64" ;; \
        arm64) runtime="linux-arm64" ;; \
        *) echo "Unsupported Pdfium target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && version="158.0.8125" \
    && package="bblanchon.pdfium.linux.$version.nupkg" \
    && package_url="https://api.nuget.org/v3-flatcontainer/bblanchon.pdfium.linux/$version/$package" \
    && curl --fail --show-error --location --retry 5 --retry-delay 2 --retry-max-time 120 \
        "$package_url" -o "/tmp/$package" \
    && curl --fail --show-error --location --retry 5 --retry-delay 2 --retry-max-time 120 \
        "$package_url.sha512" -o /tmp/pdfium.sha512 \
    && expected_sha512="$(base64 -d /tmp/pdfium.sha512 | od -An -tx1 | tr -d ' \n')" \
    && echo "$expected_sha512  /tmp/$package" | sha512sum -c - \
    && mkdir -p /usr/local/lib \
    && unzip -p "/tmp/$package" "runtimes/$runtime/native/libpdfium.so" > /usr/local/lib/libpdfium.so \
    && rm -rf /var/lib/apt/lists/* /tmp/$package /tmp/pdfium.sha512

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 568 app \
    && useradd --system --create-home --uid 568 --gid app app
COPY --from=builder /app/target/release/kpapers-api /usr/local/bin/kpapers-api
COPY --from=pdfium /usr/local/lib/libpdfium.so /usr/local/lib/libpdfium.so
RUN ldconfig
RUN mkdir -p /data && chown app:app /data
USER 568:568
ENV DATABASE_URL=sqlite:///data/kpapers.sqlite?mode=rwc
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/usr/local/bin/kpapers-api", "--healthcheck"]
CMD ["/usr/local/bin/kpapers-api"]
