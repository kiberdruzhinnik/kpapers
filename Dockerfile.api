FROM rust:1-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./

# Compile dependencies against a stub binary so source-only changes can reuse
# the dependency layer. The lockfile and toolchain image still invalidate it.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    mkdir -p src \
    && printf 'fn main() {}\n' > src/main.rs \
    && cargo build --release --locked \
    && rm -rf src

COPY src ./src
COPY migrations ./migrations
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    find src -type f -exec touch {} + \
    && cargo build --release --locked

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 568 app \
    && useradd --system --create-home --uid 568 --gid app app
COPY --from=builder /app/target/release/kpapers-api /usr/local/bin/kpapers-api
RUN mkdir -p /data && chown app:app /data
USER 568:568
ENV DATABASE_URL=sqlite:///data/kpapers.sqlite?mode=rwc
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/usr/local/bin/kpapers-api", "--healthcheck"]
CMD ["/usr/local/bin/kpapers-api"]
